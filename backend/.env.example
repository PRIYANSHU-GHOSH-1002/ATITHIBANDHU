PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/atithibandhu
# Set this to true to skip needing MongoDB installed/Atlas entirely - spins up
# a temporary in-memory database instead. Data resets every server restart.
# Good for quick local testing only, not for real use.
USE_MEMORY_DB=false
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_ORIGIN=http://localhost:3000
# Distance (meters) jumped in <5s that is flagged as a GPS anomaly / spoof
ANOMALY_JUMP_METERS=1000
# Minutes of no location update before a tourist is flagged "inactive"
INACTIVITY_MINUTES=30

# --- AI safety model integration (optional) ---
# Leave AI_MODEL_URL blank/unset until your model is ready - the system works
# fine without it (falls back to geofence-only classification). Once your
# model is deployed, just set this URL and everything wires up automatically -
# no code changes needed. See backend/utils/aiSafety.js for the exact request/
# response contract your model API must follow.
AI_MODEL_URL=
AI_MODEL_API_KEY=
AI_MODEL_TIMEOUT_MS=3000
